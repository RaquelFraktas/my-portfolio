{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // only API calls run the Worker; everything else is served as static files
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // DATABASE_URL (the blog_app connection string) is a secret:
  //   npx wrangler secret put DATABASE_URL
}
